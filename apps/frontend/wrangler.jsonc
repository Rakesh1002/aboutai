{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "theaidaily",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aboutai",
      "database_id": "0874478e-4f18-4134-81fc-04ebfe9031fa",
      "migrations_dir": "migrations"
    }
  ],

  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "RATELIMITS",
      "id": "5d005779ec6342b2aec6c93be44bf44b"
    }
  ],

  "vars": {
    "SITE_URL": "https://theaidaily.in",
    "FROM_EMAIL": "hello@theaidaily.in",
    "FROM_NAME": "Rakesh from The AI Daily",
    "BULK_EMAIL_PROVIDER": "none"
  }
}
