# Local-only fallbacks. In production these come from wrangler.jsonc `vars`
# and from D1/EMAIL bindings. See wrangler.jsonc for the source of truth.

NEXT_PUBLIC_APP_URL=https://aboutai.space
SITE_URL=https://aboutai.space
FROM_EMAIL=hello@aboutai.space
FROM_NAME=Rakesh from aboutai

# Bulk newsletter provider for the Friday blast (NOT used for transactional;
# transactional sends go through the CF EMAIL binding).
# Cloudflare Email Sending is transactional-only per CF policy, so the
# Friday blast must route through a dedicated provider OR a self-hosted
# MTA on CF Containers.
#   none    — disable bulk sends entirely (Phase 1 default)
#   resend  — use Resend API (set RESEND_API_KEY)
#   ses     — use AWS SES (not yet wired)
BULK_EMAIL_PROVIDER=none
RESEND_API_KEY=
