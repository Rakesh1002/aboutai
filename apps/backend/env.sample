# ===========================================
# aboutai Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# LLM Providers
# ===========================================
# Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_PROVIDER=anthropic  # anthropic or openai

# OpenAI (fallback)
OPENAI_API_KEY=sk-your-openai-key-here

# ===========================================
# Supabase (Database)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ===========================================
# Upstash Redis (Task Queue)
# ===========================================
# REST API credentials (the app will construct the Redis URL automatically)
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Or set REDIS_URL directly if using a different Redis provider
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# Self-Hosted Services (Optional)
# ===========================================
# SearXNG (self-hosted search - optional)
SEARXNG_URL=http://localhost:8080

# ===========================================
# External APIs (Optional)
# ===========================================
# GitHub token for higher rate limits
GITHUB_TOKEN=ghp_your-github-token

# Beehiiv (newsletter)
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=your-publication-id

# ===========================================
# Application Settings
# ===========================================
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# Pipeline Settings
# ===========================================
MAX_NEWS_PER_RUN=50
MAX_TOOLS_PER_RUN=30
AUTO_APPROVE_THRESHOLD=0.8
TRUST_SCORE_MIN_PUBLISH=30
